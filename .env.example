# Premier administrateur : option recommandée.
# Le compte inscrit avec ce courriel est automatiquement approuvé comme administrateur.
BOOTSTRAP_ADMIN_EMAIL=admin@votre-magasin.ca

# Solution de secours pour créer le premier administrateur depuis l’écran d’attente.
# Une fois le premier admin créé, ce code ne peut plus être utilisé pour promouvoir un compte.
APP_PIN=change-moi-avec-un-long-code

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-nano

SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
